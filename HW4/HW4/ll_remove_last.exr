
(* Example 1 *)

let l1 = { head <= 0; length <= 0} (* 0 in head signals null *)
in let add_front = proc (x) { proc (l) {
   	      begin
	         l.head <={ data <=x; next <= l.head };
		 l.length <= l.length+1
              end
	      } }
in let remove_last = proc (l) {
  if number?(l.head)
    then 0
  else if number?((l.head).next)
    then l.head <= 0
  else let rec helper = proc (nd) {
    if number?(nd.next.next)
      then nd.next <= 0
    else (helper nd.next)
  } in
  (helper (l.head));
  
  l.length <= l.length - 1
}
in begin
     ((add_front 2) l1);
     ((add_front 3) l1);
     ((add_front 4) l1);
     (remove_last l1);
     debug(l1)  (* required inspect the list *)
   end